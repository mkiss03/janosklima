---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@/styles/global.css';
import { COMPANY, REGIONS_PRIMARY } from '@/lib/constants';

interface Props {
  title: string;
  description: string;
  lang?: 'de' | 'hu';
  noindex?: boolean;
}

const { title, description, lang = 'de', noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

const pathname = Astro.url.pathname;
const dePath = lang === 'hu' ? pathname.replace(/^\/hu/, '') || '/' : pathname;
const huPath = lang === 'de' ? '/hu' + (pathname === '/' ? '/' : pathname) : pathname;
const deURL = new URL(dePath, Astro.site);
const huURL = new URL(huPath, Astro.site);

const htmlLang = lang === 'hu' ? 'hu' : 'de-AT';
const ogLocale = lang === 'hu' ? 'hu_HU' : 'de_AT';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: COMPANY.name,
  image: ogImage.toString(),
  telephone: COMPANY.phoneAT,
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.addressStreet,
    postalCode: COMPANY.addressZip,
    addressLocality: COMPANY.addressCity,
    addressCountry: 'HU',
  },
  areaServed: REGIONS_PRIMARY.map((r) => ({ '@type': 'AdministrativeArea', name: r })),
  vatID: COMPANY.vatId,
  founder: COMPANY.ceo,
  slogan: COMPANY.slogan,
  url: canonicalURL.toString(),
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="de-AT" href={deURL} />
    <link rel="alternate" hreflang="hu" href={huURL} />
    <link rel="alternate" hreflang="x-default" href={deURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body id="top" class="bg-paper text-ink font-body text-base">
    <slot />
  </body>
</html>
