---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/Nav.astro';
import Hero from '@/components/Hero.astro';
import BrandMarquee from '@/components/BrandMarquee.astro';
import Leistungen from '@/components/Leistungen.astro';
import VorherNachher from '@/components/VorherNachher.astro';
import Preise from '@/components/Preise.astro';
import Kontakt from '@/components/Kontakt.astro';
import Einsatzgebiet from '@/components/Einsatzgebiet.astro';
import UeberUns from '@/components/UeberUns.astro';
import Footer from '@/components/Footer.astro';

const lang = 'hu' as const;
---

<Layout
  lang={lang}
  title="Klímaszerelés Bécsben és környékén – Ecocool Klíma"
  description="Klímaberendezések telepítése, szervize és karbantartása Bécsben, Alsó- és Felső-Ausztriában, valamint Burgenlandban. Telepítés 1.100 € + áfától. Hívjon minket, vagy írjon e-mailt."
>
  <Nav lang={lang} />
  <main class="pb-16 md:pb-0">
    <Hero lang={lang} />
    <BrandMarquee lang={lang} />
    <Leistungen lang={lang} />
    <VorherNachher lang={lang} />
    <Preise lang={lang} />
    <Kontakt lang={lang} />
    <Einsatzgebiet lang={lang} />
    <UeberUns lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>
