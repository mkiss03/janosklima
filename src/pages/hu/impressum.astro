---
import LegalLayout from '@/layouts/LegalLayout.astro';
import TodoNote from '@/components/TodoNote.astro';
import { COMPANY } from '@/lib/constants';
---

<LegalLayout
  lang="hu"
  title="Impresszum – Ecocool Klíma"
  description="Az Ecocool Klíma Kft. impresszuma."
>
  <h1 class="mb-8 text-3xl text-ink [font-variation-settings:'wdth'_118]">Impresszum</h1>

  <p class="mb-1 font-body text-base text-ink">{COMPANY.name}</p>
  <p class="mb-1 font-body text-base text-ink">{COMPANY.addressStreet}</p>
  <p class="mb-6 font-body text-base text-ink">{COMPANY.addressZip} {COMPANY.addressCity}, Magyarország</p>

  <dl class="mb-8 space-y-2 font-body text-base text-ink">
    <div><dt class="inline text-neutral-700">Ügyvezető: </dt><dd class="inline">{COMPANY.ceo}</dd></div>
    <div><dt class="inline text-neutral-700">Közösségi adószám: </dt><dd class="inline">{COMPANY.vatId}</dd></div>
    <div><dt class="inline text-neutral-700">Adószám: </dt><dd class="inline">{COMPANY.taxNumber}</dd></div>
    <div><dt class="inline text-neutral-700">Telefon: </dt><dd class="inline">{COMPANY.phoneAT} · {COMPANY.phoneHU}</dd></div>
    <div>
      <dt class="inline text-neutral-700">E-mail: </dt>
      <dd class="inline">
        {COMPANY.email || <TodoNote>[TODO: e-mail cím]</TodoNote>}
      </dd>
    </div>
  </dl>

  <h2 class="mb-3 mt-10 text-xl text-ink [font-variation-settings:'wdth'_118]">
    Ausztriai szolgáltatói bejegyzés
  </h2>
  <p class="font-body text-base text-neutral-700">
    {COMPANY.registerAuthority}<br />
    Tevékenység: {COMPANY.registerTrade}<br />
    {COMPANY.registerNumber}, érvényes {COMPANY.registerValidFrom} – {COMPANY.registerValidTo}
  </p>

  <h2 class="mb-3 mt-10 text-xl text-ink [font-variation-settings:'wdth'_118]">
    Vitarendezés
  </h2>
  <p class="font-body text-base text-neutral-700">
    <TodoNote>
      [TODO: von Rechtsberatung prüfen lassen — az EU online vitarendezési
      platformjára (OS-Plattform) való hivatkozás, illetve az illetékes
      békéltető testület megnevezése, ha szükséges.]
    </TodoNote>
  </p>

  <h2 class="mb-3 mt-10 text-xl text-ink [font-variation-settings:'wdth'_118]">
    Felelősségi nyilatkozat
  </h2>
  <p class="font-body text-base text-neutral-700">
    <TodoNote>
      [TODO: von Rechtsberatung prüfen lassen — felelősség a tartalomért,
      a hivatkozásokért és az alkalmazandó jogért (osztrák, illetve magyar
      jog).]
    </TodoNote>
  </p>
</LegalLayout>
