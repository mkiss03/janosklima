---
import LegalLayout from '@/layouts/LegalLayout.astro';
import TodoNote from '@/components/TodoNote.astro';
import { COMPANY } from '@/lib/constants';
---

<LegalLayout
  lang="de"
  title="Impressum – Ecocool Klíma"
  description="Impressum der Ecocool Klíma Kft."
>
  <h1 class="mb-8 text-3xl text-ink [font-variation-settings:'wdth'_118]">Impressum</h1>

  <p class="mb-1 font-body text-base text-ink">{COMPANY.name}</p>
  <p class="mb-1 font-body text-base text-ink">{COMPANY.addressStreet}</p>
  <p class="mb-6 font-body text-base text-ink">{COMPANY.addressZip} {COMPANY.addressCity}, Ungarn</p>

  <dl class="mb-8 space-y-2 font-body text-base text-ink">
    <div><dt class="inline text-neutral-700">Geschäftsführer: </dt><dd class="inline">{COMPANY.ceo}</dd></div>
    <div><dt class="inline text-neutral-700">UID-Nummer: </dt><dd class="inline">{COMPANY.vatId}</dd></div>
    <div><dt class="inline text-neutral-700">Steuernummer (Ungarn): </dt><dd class="inline">{COMPANY.taxNumber}</dd></div>
    <div><dt class="inline text-neutral-700">Telefon: </dt><dd class="inline">{COMPANY.phoneAT} · {COMPANY.phoneHU}</dd></div>
    <div>
      <dt class="inline text-neutral-700">E-Mail: </dt>
      <dd class="inline">
        {COMPANY.email || <TodoNote>[TODO: E-Mail-Adresse]</TodoNote>}
      </dd>
    </div>
  </dl>

  <h2 class="mb-3 mt-10 text-xl text-ink [font-variation-settings:'wdth'_118]">
    Registrierung als Dienstleister in Österreich
  </h2>
  <p class="font-body text-base text-neutral-700">
    {COMPANY.registerAuthority}<br />
    Gewerbe: {COMPANY.registerTrade}<br />
    {COMPANY.registerNumber}, gültig {COMPANY.registerValidFrom} – {COMPANY.registerValidTo}
  </p>

  <h2 class="mb-3 mt-10 text-xl text-ink [font-variation-settings:'wdth'_118]">
    Streitschlichtung
  </h2>
  <p class="font-body text-base text-neutral-700">
    <TodoNote>
      [TODO: von Rechtsberatung prüfen lassen — Hinweis auf
      Online-Streitbeilegungsplattform (OS-Plattform) der EU-Kommission und ggf.
      zuständige Schlichtungsstelle, falls für dieses Unternehmen erforderlich.]
    </TodoNote>
  </p>

  <h2 class="mb-3 mt-10 text-xl text-ink [font-variation-settings:'wdth'_118]">
    Haftungshinweis
  </h2>
  <p class="font-body text-base text-neutral-700">
    <TodoNote>
      [TODO: von Rechtsberatung prüfen lassen — Haftung für
      Inhalte, Links und angewandtes Recht (Verweis auf österreichisches bzw.
      ungarisches Recht).]
    </TodoNote>
  </p>
</LegalLayout>
