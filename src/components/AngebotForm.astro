---
const ARTEN = ['Montage', 'Reparatur', 'Wartung'] as const;
const BUNDESLAENDER = [
  'Wien',
  'Niederösterreich',
  'Oberösterreich',
  'Burgenland',
  'Steiermark',
  'Kärnten',
  'Salzburg',
  'Tirol',
  'Vorarlberg',
] as const;
---

<section id="angebot" class="bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <h2 class="mb-4 text-3xl text-ink md:text-4xl [font-variation-settings:'wdth'_118]">
          Angebot anfragen
        </h2>
        <p class="max-w-measure font-body text-base text-neutral-700">
          Ein paar Fotos oder ein kurzes Video von der geplanten Stelle
          helfen uns, ein genaues Angebot zu erstellen – oft ohne
          Besichtigung vor Ort.
        </p>
      </div>

      <div class="col-span-12 md:col-span-8">
        <form data-angebot-form novalidate class="max-w-2xl">
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <span class="font-body text-sm text-ink">Name</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                class="rounded-btn border border-neutral-300 bg-white px-3.5 py-2.5 font-body text-base text-ink focus:border-ice-600"
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="font-body text-sm text-ink">Telefon</span>
              <input
                type="tel"
                name="telefon"
                required
                autocomplete="tel"
                class="rounded-btn border border-neutral-300 bg-white px-3.5 py-2.5 font-body text-base text-ink focus:border-ice-600"
              />
            </label>

            <label class="flex flex-col gap-1.5 sm:col-span-2">
              <span class="font-body text-sm text-ink">E-Mail</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="rounded-btn border border-neutral-300 bg-white px-3.5 py-2.5 font-body text-base text-ink focus:border-ice-600"
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="font-body text-sm text-ink">PLZ</span>
              <input
                type="text"
                name="plz"
                inputmode="numeric"
                required
                autocomplete="postal-code"
                class="rounded-btn border border-neutral-300 bg-white px-3.5 py-2.5 font-body text-base text-ink focus:border-ice-600"
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="font-body text-sm text-ink">Ort</span>
              <input
                type="text"
                name="ort"
                required
                autocomplete="address-level2"
                class="rounded-btn border border-neutral-300 bg-white px-3.5 py-2.5 font-body text-base text-ink focus:border-ice-600"
              />
            </label>

            <label class="flex flex-col gap-1.5 sm:col-span-2">
              <span class="font-body text-sm text-ink">Bundesland</span>
              <select
                name="bundesland"
                data-bundesland-select
                class="rounded-btn border border-neutral-300 bg-white px-3.5 py-2.5 font-body text-base text-ink focus:border-ice-600"
              >
                <option value="">Bitte wählen</option>
                {BUNDESLAENDER.map((b) => <option value={b}>{b}</option>)}
              </select>
            </label>
          </div>

          <fieldset class="mt-6">
            <legend class="mb-2 font-body text-sm text-ink">Art der Anfrage</legend>
            <div class="flex flex-wrap gap-5">
              {
                ARTEN.map((art, i) => (
                  <label class="flex items-center gap-2 font-body text-base text-ink">
                    <input
                      type="radio"
                      name="art"
                      value={art}
                      required
                      checked={i === 0}
                      class="h-4 w-4 accent-ice-600"
                    />
                    {art}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <label class="mt-6 flex flex-col gap-1.5">
            <span class="font-body text-sm text-ink">
              Kurze Beschreibung
            </span>
            <textarea
              name="beschreibung"
              rows="4"
              placeholder="Wo soll das Innengerät montiert werden, wo das Außengerät, ca. Entfernung dazwischen …"
              class="rounded-btn border border-neutral-300 bg-white px-3.5 py-2.5 font-body text-base text-ink focus:border-ice-600"
            ></textarea>
          </label>

          <div class="mt-6">
            <span class="mb-1.5 block font-body text-sm text-ink">
              Fotos / Video
              <span class="text-neutral-500">(max. 5 Dateien, max. 50 MB gesamt)</span>
            </span>

            <label
              class="flex cursor-pointer items-center justify-center rounded-btn border border-dashed border-neutral-300 bg-white px-4 py-6 font-body text-sm text-neutral-500 transition-colors duration-220 ease-studio hover:border-ice-600"
            >
              <span>Dateien auswählen oder hierher ziehen</span>
              <input
                type="file"
                name="dateien"
                accept="image/*,video/*"
                multiple
                data-file-input
                class="sr-only"
              />
            </label>

            <ul data-file-list class="mt-3 space-y-2"></ul>
            <p data-file-error class="mt-2 font-body text-sm text-sun-600" role="alert"></p>
          </div>

          <label class="mt-6 flex items-start gap-2.5">
            <input
              type="checkbox"
              name="datenschutz"
              required
              class="mt-1 h-4 w-4 accent-ice-600"
            />
            <span class="font-body text-sm text-neutral-700">
              Ich stimme zu, dass meine Angaben zur Bearbeitung meiner Anfrage
              gespeichert werden. Mehr dazu in der
              <a href="/datenschutz" class="text-ice-600 underline underline-offset-2">
                Datenschutzerklärung
              </a>.
            </span>
          </label>

          <button
            type="submit"
            class="mt-8 rounded-btn bg-sun-500 px-7 py-3 font-body text-base font-medium text-ink transition-colors duration-220 ease-studio hover:bg-sun-600 hover:text-paper"
          >
            Anfrage senden
          </button>

          <p data-form-status class="mt-4 font-body text-base" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { FORM_ENDPOINT } from '@/lib/constants';

  const MAX_FILES = 5;
  const MAX_TOTAL_BYTES = 50 * 1024 * 1024;

  const form = document.querySelector<HTMLFormElement>('[data-angebot-form]');
  if (form) {
    const fileInput = form.querySelector<HTMLInputElement>('[data-file-input]');
    const fileList = form.querySelector<HTMLUListElement>('[data-file-list]');
    const fileError = form.querySelector<HTMLElement>('[data-file-error]');
    const statusEl = form.querySelector<HTMLElement>('[data-form-status]');
    const bundeslandSelect = form.querySelector<HTMLSelectElement>('[data-bundesland-select]');

    let files: File[] = [];

    const formatSize = (bytes: number) => `${(bytes / (1024 * 1024)).toFixed(1)} MB`;

    const renderFiles = () => {
      if (!fileList) return;
      fileList.innerHTML = '';
      files.forEach((file, index) => {
        const li = document.createElement('li');
        li.className =
          'flex items-center justify-between gap-3 rounded-btn border border-neutral-200 bg-white px-3 py-2 font-body text-sm text-ink';
        const label = document.createElement('span');
        label.textContent = `${file.name} · ${formatSize(file.size)}`;
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.textContent = 'Entfernen';
        removeBtn.className = 'text-ice-600 underline underline-offset-2';
        removeBtn.addEventListener('click', () => {
          files.splice(index, 1);
          renderFiles();
        });
        li.append(label, removeBtn);
        fileList.appendChild(li);
      });
    };

    fileInput?.addEventListener('change', () => {
      if (fileError) fileError.textContent = '';
      const incoming = Array.from(fileInput.files ?? []);
      let candidate = [...files, ...incoming];

      if (candidate.length > MAX_FILES) {
        if (fileError) fileError.textContent = `Zu viele Dateien, max. ${MAX_FILES}.`;
        candidate = candidate.slice(0, MAX_FILES);
      }

      const total = candidate.reduce((sum, f) => sum + f.size, 0);
      if (total > MAX_TOTAL_BYTES) {
        if (fileError) fileError.textContent = 'Dateien zu groß, max. 50 MB insgesamt.';
        candidate = files;
      }

      files = candidate;
      fileInput.value = '';
      renderFiles();
    });

    window.addEventListener('ecocool:select-region', ((e: CustomEvent<{ region: string }>) => {
      if (bundeslandSelect && e.detail?.region) {
        bundeslandSelect.value = e.detail.region;
      }
    }) as EventListener);

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      if (statusEl) {
        statusEl.textContent = 'Anfrage wird gesendet …';
        statusEl.className = 'mt-4 font-body text-base text-neutral-600';
      }

      const formData = new FormData(form);
      formData.delete('dateien');
      files.forEach((file) => formData.append('dateien', file));

      try {
        const response = await fetch(FORM_ENDPOINT, {
          method: 'POST',
          body: formData,
        });
        if (!response.ok) throw new Error('Server-Fehler');

        form.hidden = true;
        if (statusEl) {
          statusEl.textContent = 'Anfrage gesendet. Wir melden uns [TODO: Reaktionszeit].';
          statusEl.className = 'mt-4 font-body text-base text-ice-600';
        }
      } catch {
        if (statusEl) {
          statusEl.textContent =
            'Die Anfrage konnte nicht gesendet werden. Bitte versuchen Sie es erneut oder rufen Sie uns an.';
          statusEl.className = 'mt-4 font-body text-base text-sun-600';
        }
      }
    });
  }
</script>
