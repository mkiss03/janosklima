---
import Logo from './icons/Logo.astro';
import { COMPANY, NAV_LINKS } from '@/lib/constants';

interface Props {
  lang?: 'de' | 'hu';
}
const { lang = 'de' } = Astro.props;

const navLabels: Record<'de' | 'hu', Record<string, string>> = {
  de: {
    leistungen: 'Leistungen',
    preise: 'Preise',
    einsatzgebiet: 'Einsatzgebiet',
    kontakt: 'Kontakt',
  },
  hu: {
    leistungen: 'Szolgáltatások',
    preise: 'Árak',
    einsatzgebiet: 'Területünk',
    kontakt: 'Kapcsolat',
  },
};
const t = navLabels[lang];
const labelFor = (href: string) => t[href.replace('#', '')] ?? href;

const callLabel = lang === 'hu' ? 'Hívás most' : 'Jetzt anrufen';

const pathname = Astro.url.pathname;
const dePath = pathname.replace(/^\/hu/, '') || '/';
const huPath = '/hu' + (pathname === '/' ? '/' : pathname.replace(/^\/hu/, ''));
---

<header
  class="sticky top-0 z-40 border-b border-neutral-200 bg-paper/90 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-content items-center justify-between gap-4 px-5 py-3 sm:px-8"
  >
    <a href="#top" class="shrink-0" aria-label="Ecocool Klíma – Startseite">
      <Logo />
    </a>

    <nav
      class="hidden items-center gap-7 font-body text-sm text-ink md:flex"
      aria-label="Hauptnavigation"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="transition-colors duration-220 ease-studio hover:text-ice-600"
          >
            {labelFor(link.href)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <div class="hidden items-center gap-1 font-body text-xs text-neutral-500 sm:flex" role="group" aria-label="Sprache">
        <a href={dePath} class={lang === 'de' ? 'text-ink' : 'hover:text-ice-600'} aria-current={lang === 'de' ? 'page' : undefined}>DE</a>
        <span aria-hidden="true">/</span>
        <a href={huPath} class={lang === 'hu' ? 'text-ink' : 'hover:text-ice-600'} aria-current={lang === 'hu' ? 'page' : undefined}>HU</a>
      </div>

      <a
        href={COMPANY.phoneATHref}
        class="hidden items-center gap-2 rounded-btn bg-ice-900 px-4 py-2 font-body text-sm font-medium text-paper transition-colors duration-220 ease-studio hover:bg-ice-600 md:inline-flex"
      >
        {COMPANY.phoneAT}
      </a>
    </div>
  </div>

  <nav
    class="flex items-center gap-5 overflow-x-auto border-t border-neutral-200 px-5 py-2.5 font-body text-sm text-ink md:hidden"
    aria-label="Hauptnavigation"
  >
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class="whitespace-nowrap">
          {labelFor(link.href)}
        </a>
      ))
    }
  </nav>
</header>

<a
  href={COMPANY.phoneATHref}
  class="fixed inset-x-0 bottom-0 z-40 flex items-center justify-center gap-2 bg-ice-900 py-3.5 text-center font-body text-base font-medium text-paper md:hidden"
>
  {callLabel} · {COMPANY.phoneAT}
</a>
