---
// Redrawn as vector from the client's raster logo (sun / snowflake / wave).
// Not a trace of the original file — simplified to clean geometry.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  class={className}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Ecocool Klíma Logo"
>
  <path
    d="M2 30c5-6 9-6 14 0s9 6 14 0 9-6 14 0 3.5 3.5 4 4"
    stroke="#E4552B"
    stroke-width="2.6"
    stroke-linecap="round"
    fill="none"
  />
  <path
    d="M2 35.5c5-6 9-6 14 0s9 6 14 0 9-6 14 0"
    stroke="#1E5AA8"
    stroke-width="2.6"
    stroke-linecap="round"
    fill="none"
  />
  <g>
    <circle cx="33.5" cy="13" r="5.4" fill="#F28A1E" />
    <g stroke="#F28A1E" stroke-width="2" stroke-linecap="round">
      <line x1="33.5" y1="2.2" x2="33.5" y2="5" />
      <line x1="33.5" y1="21" x2="33.5" y2="23.8" />
      <line x1="22.7" y1="13" x2="25.5" y2="13" />
      <line x1="41.5" y1="13" x2="44.3" y2="13" />
      <line x1="26.1" y1="5.6" x2="28" y2="7.5" />
      <line x1="39" y1="18.5" x2="40.9" y2="20.4" />
      <line x1="40.9" y1="5.6" x2="39" y2="7.5" />
      <line x1="28" y1="18.5" x2="26.1" y2="20.4" />
    </g>
  </g>
  <g stroke="#4FB8E6" stroke-width="1.8" stroke-linecap="round">
    <line x1="10.5" y1="15" x2="10.5" y2="27" />
    <line x1="5" y1="18" x2="16" y2="24" />
    <line x1="16" y1="18" x2="5" y2="24" />
  </g>
</svg>
