---
// Redrawn as vector from the client's raster logo (sun / snowflake / three-band
// wave). Not a trace of the original file — simplified to clean geometry using
// only brand tokens (no gradients, matching the rest of the site).
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  class={className}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Ecocool Klíma Logo"
>
  <path
    d="M2 25c5-6 9-6 14 0s9 6 14 0 9-6 14 0 3.5 3.5 4 4"
    stroke="#E4552B"
    stroke-width="2.4"
    stroke-linecap="round"
    fill="none"
  />
  <path
    d="M2 30c5-6 9-6 14 0s9 6 14 0 9-6 14 0 3.5 3.5 4 4"
    stroke="#1E5AA8"
    stroke-width="2.4"
    stroke-linecap="round"
    fill="none"
  />
  <path
    d="M2 35c5-6 9-6 14 0s9 6 14 0 9-6 14 0"
    stroke="#4FB8E6"
    stroke-width="2.4"
    stroke-linecap="round"
    fill="none"
  />

  <g>
    <circle cx="33.5" cy="15" r="5.4" fill="#F28A1E" />
    <g stroke="#F28A1E" stroke-width="2" stroke-linecap="round">
      <line x1="33.5" y1="4.2" x2="33.5" y2="7" />
      <line x1="33.5" y1="23" x2="33.5" y2="25.8" />
      <line x1="22.7" y1="15" x2="25.5" y2="15" />
      <line x1="41.5" y1="15" x2="44.3" y2="15" />
      <line x1="26.1" y1="7.6" x2="28" y2="9.5" />
      <line x1="39" y1="20.5" x2="40.9" y2="22.4" />
      <line x1="40.9" y1="7.6" x2="39" y2="9.5" />
      <line x1="28" y1="20.5" x2="26.1" y2="22.4" />
    </g>
  </g>

  <g stroke="#1E5AA8" stroke-width="1.6" stroke-linecap="round">
    <line x1="2" y1="30" x2="16" y2="30" />
    <line x1="5.5" y1="23.94" x2="12.5" y2="36.06" />
    <line x1="12.5" y1="23.94" x2="5.5" y2="36.06" />
    <line x1="16" y1="28.6" x2="16" y2="31.4" />
    <line x1="11.29" y1="23.24" x2="13.71" y2="24.64" />
    <line x1="4.29" y1="24.64" x2="6.71" y2="23.24" />
