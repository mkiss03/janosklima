---
import LogoMark from './icons/LogoMark.astro';
import PoweredByWelisse from './PoweredByWelisse.astro';
import TodoNote from './TodoNote.astro';
import { COMPANY } from '@/lib/constants';

interface Props {
  lang?: 'de' | 'hu';
}
const { lang = 'de' } = Astro.props;

const currentYear = new Date().getFullYear();
const prefix = lang === 'hu' ? '/hu' : '';

const copy = {
  de: {
    slogan: COMPANY.slogan,
    kontakt: 'Kontakt',
    country: 'Ungarn',
    rechtliches: 'Rechtliches',
    impressum: 'Impressum',
    datenschutz: 'Datenschutzerklärung',
    agb: 'AGB',
    emailTodo: '[TODO: E-Mail-Adresse]',
    uidLabel: 'UID',
    taxLabel: 'Steuernummer',
    ceoLabel: 'Geschäftsführer',
    registeredLabel: 'Registriert im',
    validLabel: 'gültig',
  },
  hu: {
    slogan: 'Kényelem egész évben',
    kontakt: 'Kapcsolat',
    country: 'Magyarország',
    rechtliches: 'Jogi információk',
    impressum: 'Impresszum',
    datenschutz: 'Adatvédelem',
    agb: 'ÁSZF',
    emailTodo: '[TODO: e-mail cím]',
    uidLabel: 'Közösségi adószám',
    taxLabel: 'Adószám',
    ceoLabel: 'Ügyvezető',
    registeredLabel: 'Bejegyezve',
    validLabel: 'érvényes',
  },
} as const;
const t = copy[lang];
---

<footer class="bg-ice-900 py-16 text-paper">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-4">
        <div class="flex items-center gap-3">
          <LogoMark class="h-10 w-10 shrink-0" />
          <span class="font-display text-2xl text-paper [font-variation-settings:'wdth'_112]">
            Ecocool&nbsp;Klíma
          </span>
        </div>
        <p class="mt-4 font-body text-sm text-paper/60">{t.slogan}</p>
      </div>

      <div class="col-span-6 md:col-span-4">
        <p class="mb-3 font-body text-sm text-paper/70">{t.kontakt}</p>
        <ul class="space-y-1.5 font-body text-base text-paper/90">
          <li><a href={COMPANY.phoneATHref} class="hover:text-ice-400">{COMPANY.phoneAT}</a></li>
          <li><a href={COMPANY.phoneHUHref} class="hover:text-ice-400">{COMPANY.phoneHU}</a></li>
          <li>
            {COMPANY.email
              ? <a href={`mailto:${COMPANY.email}`} class="hover:text-ice-400">{COMPANY.email}</a>
              : <TodoNote>{t.emailTodo}</TodoNote>}
          </li>
        </ul>
        <p class="mt-4 font-body text-sm text-paper/70">
          {COMPANY.addressStreet}<br />
          {COMPANY.addressZip} {COMPANY.addressCity}, {t.country}
        </p>
      </div>

      <div class="col-span-6 md:col-span-4">
        <p class="mb-3 font-body text-sm text-paper/70">{t.rechtliches}</p>
        <ul class="space-y-1.5 font-body text-base text-paper/90">
          <li><a href={`${prefix}/impressum`} class="hover:text-ice-400">{t.impressum}</a></li>
          <li><a href={`${prefix}/datenschutz`} class="hover:text-ice-400">{t.datenschutz}</a></li>
          <li><a href={`${prefix}/agb`} class="hover:text-ice-400">{t.agb}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-paper/10 pt-6">
      <p class="max-w-measure font-body text-xs leading-relaxed text-paper/65">
        {COMPANY.name} · {t.uidLabel} {COMPANY.vatId} · {t.taxLabel} {COMPANY.taxNumber} ·{' '}
        {t.ceoLabel} {COMPANY.ceo}<br />
        {t.registeredLabel} {COMPANY.registerAuthority} ({COMPANY.registerTrade}),{' '}
        {COMPANY.registerNumber}, {t.validLabel} {COMPANY.registerValidFrom}–{COMPANY.registerValidTo}.
      </p>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="font-body text-xs text-paper/58">
          © {currentYear} {COMPANY.name}
        </p>
        <PoweredByWelisse theme="dark" utm="ecocool-klima.at" />
      </div>
    </div>
  </div>
</footer>
