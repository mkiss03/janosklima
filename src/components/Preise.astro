---
import { PRICING } from '@/lib/constants';
---

<section id="preise" class="bg-paper py-20 md:py-28">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-12 md:col-span-7">
        <p class="mb-3 font-body text-lg text-neutral-700">Montage ab</p>
        <p class="mb-8 font-display text-5xl text-ink sm:text-6xl [font-variation-settings:'wdth'_112]">
          {PRICING.startingPrice}
          <span class="text-2xl text-neutral-500">{PRICING.vatNote}</span>
        </p>

        <ul class="max-w-measure space-y-2 border-t border-neutral-200 pt-6 font-body text-base text-neutral-700">
          <li>Bis {PRICING.maxPipeLength} Leitungslänge</li>
          <li>Bis {PRICING.maxRoomHeight} Raumhöhe</li>
          <li>Innen- und Außengerät</li>
          <li>Inbetriebnahme</li>
        </ul>
      </div>

      <div class="col-span-12 md:col-span-5 md:pt-16">
        <p class="max-w-measure font-body text-base text-neutral-700">
          Jede Montage ist unterschiedlich. Das genaue Angebot erstellen wir
          nach einer Besichtigung vor Ort oder anhand von Fotos bzw. einem
          Video, das Sie uns schicken.
        </p>
        <a
          href="#angebot"
          class="mt-6 inline-block rounded-btn bg-ice-900 px-6 py-3 font-body text-base font-medium text-paper transition-colors duration-220 ease-studio hover:bg-ice-600"
        >
          Angebot mit Foto anfragen
        </a>
      </div>
    </div>
  </div>
</section>
